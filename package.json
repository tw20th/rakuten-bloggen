{
  "name": "affi-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@apps/chargescope",
    "dev": "npm run dev --workspace=@apps/chargescope",
    "lint": "npm run lint --workspace=@apps/chargescope",
    "typecheck": "npm run typecheck --workspace=@apps/chargescope",
    "guard": "tsx tools/predeploy-guard/index.ts"
  },
  "devDependencies": {
    "dotenv": "^17.2.2",
    "tsx": "^4.20.5"
  }
}
